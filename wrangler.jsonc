{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "a2-workout",
  "main": "worker/index.js",
  "compatibility_date": "2026-08-15",
  "workers_dev": true,
  "routes": [
    {
      "pattern": "app.reptrio.com",
      "custom_domain": true
    },
    {
      "pattern": "api.reptrio.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./.cloudflare-assets",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/runtime-config.js", "/reset-password"]
  },
  "triggers": { "crons": ["*/15 * * * *"] },
  "vars": {
    "RECORD_TRANSPORT_ENABLED": "true",
    "OPENAI_IMPORT_MODEL": "gpt-4.1-mini",
    "OPENAI_IMPORT_TIMEOUT_MS": "90000",
    "OPENAI_IMPORT_MAX_RETRIES": "2",
    "OPENAI_IMPORT_RETRY_BASE_MS": "750",
    "OPENAI_IMPORT_MAX_INPUT_BYTES": "180000",
    "OPENAI_IMPORT_MAX_FILE_BYTES": "6000000"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "a2-workout-pilot",
      "database_id": "0176e2d5-d306-4e4b-beda-4e63f27294fb",
      "migrations_dir": "migrations"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "IMPORT_QUEUE",
        "queue": "a2-import-jobs"
      }
    ],
    "consumers": [
      {
        "queue": "a2-import-jobs",
        "max_batch_size": 1,
        "max_batch_timeout": 5,
        "max_retries": 2
      }
    ]
  },
  "ratelimits": [
    {
      "name": "AI_IMPORT_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 4,
        "period": 60
      }
    },
    {
      "name": "PASSWORD_RESET_LIMITER",
      "namespace_id": "1002",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ]
}
