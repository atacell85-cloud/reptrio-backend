// Build 45 isolated STAGING Worker: the unchanged production Worker code (via entry.mjs) on a SEPARATE throwaway D1.
// Delete both when Build 45 device testing is over. Differences from production (wrangler.jsonc), all deliberate:
// - name/database: `a2-workout-apnstest` / `reptrio-apnstest` (never `a2-workout`/`a2-workout-pilot`).
// - workers.dev URL only (no routes/custom domains, no preview URLs, no static assets).
// - no queues, rate limiters, mail or OpenAI keys: AI import, mail-based flows and imports are unavailable here.
// - one cron, the production minute cron (account purge + Live Activity end). Workers Free allows 5 crons per account;
//   production needs 3 after the Build 44 deploy.
// - APNS_TEAM_ID is public; APNS_KEY_ID / APNS_PRIVATE_KEY / APNSTEST_TOKEN are Worker secrets (never in the repo).
{
  "$schema": "../../../node_modules/wrangler/config-schema.json",
  "name": "a2-workout-apnstest",
  "main": "./entry.mjs",
  "compatibility_date": "2026-08-15",
  "workers_dev": true,
  "preview_urls": false,
  "triggers": { "crons": ["* * * * *"] },
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "vars": { "APNS_TEAM_ID": "C4P47F32C8", "RECORD_TRANSPORT_ENABLED": "true", "PERSONAL_RESTORE_ENABLED": "true" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "reptrio-apnstest",
      "database_id": "eeff9885-3413-4ae6-a232-3b7d2324a65a",
      "migrations_dir": "../../../migrations"
    }
  ]
}
